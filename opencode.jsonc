{
  // Project config - committed to repo
  // See https://opencode.ai/docs
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "agent": {
    "build": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "permission": {
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "ls*": "allow",
          "pnpm*": "allow",
          "pnpm add*": "ask",
          "pnpm remove*": "ask",
          "npm*": "deny",
          "npx*": "deny",
          "yarn*": "deny"
        },
        "edit": "allow"
      }
    },
    "plan": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "general": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "explore": {
      "model": "deepseek/deepseek-v4-flash"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "watcher": {
    "ignore": ["node_modules", ".next", "dist", ".turbo"]
  }
}
