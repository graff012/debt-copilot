# Local dev database (docker compose up -d db). Never commit real secrets.
DATABASE_URL=postgres://debt:debt@localhost:5433/debtcopilot
REDIS_URL=redis://localhost:6380
# Dev-only secrets. Production values come from the environment, never files.
JWT_SECRET=dev-only-not-a-secret-replace-in-prod-000000
BOT_SECRET=dev-only-bot-secret-replace-in-prod
TELEGRAM_BOT_USERNAME=DebtCopilotBot
# Empty = jobs run, Telegram sends log + skip. From BotFather when ready.
TELEGRAM_BOT_TOKEN=
